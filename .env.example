LOG_LEVEL=INFO

# Reasoning model. Provider and key name are provisional until the stack is validated.
REASONING_API_BASE=
REASONING_API_KEY=

# REASONING_MODEL=glm-5.3-flash
# REASONING_EFFORT=low
# REASONING_MAX_TOKENS=400

# Turn shape. HISTORY_TURNS is how many past turns the voice call sees.
# HISTORY_TURNS=10

# A scene is built beside its turn by one call at SCENE_EFFORT under SCENE_MAX_TOKENS, a stop
# guard rather than a target, within SCENE_TIMEOUT_S; SCENE_MODEL draws it on the same endpoint
# and key, and empty means the reasoning model.
# SCENE_MODEL=
# SCENE_EFFORT=high
# SCENE_MAX_TOKENS=128000
# SCENE_TIMEOUT_S=600

# The lesson is planned at connect by one call at PLANNER_EFFORT under PLANNER_MAX_TOKENS,
# a stop guard, within PLANNER_TIMEOUT_S; PLANNER_MODEL plans it on the same endpoint and
# empty means REASONING_MODEL. Both come from scripts/bench_planner.py at n=30: the timeout is
# the largest stage p95 rounded up, the budget the largest output plus headroom.
# PLANNER_MODEL=
# PLANNER_EFFORT=high
# PLANNER_MAX_TOKENS=21000
# PLANNER_TIMEOUT_S=270

# SIGNALING_PORT=8080

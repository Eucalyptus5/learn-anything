LOG_LEVEL=INFO

# Reasoning model. Provider and key name are provisional until the stack is validated.
REASONING_API_BASE=
REASONING_API_KEY=

# REASONING_MODEL=glm-5.3-flash
# REASONING_EFFORT=low
# REASONING_MAX_TOKENS=400

# Turn shape. HISTORY_TURNS is how many past turns both model calls see; VISUAL_TIMEOUT_S caps
# the visual call; VISUAL_MAX_TOKENS is its completion cap; VISUAL_MODEL draws the visuals on
# the same endpoint and key, and empty means the reasoning model.
# HISTORY_TURNS=10
# VISUAL_TIMEOUT_S=90
# VISUAL_MAX_TOKENS=3000
# VISUAL_MODEL=

# A scene is built ahead of its turn by one call at SCENE_EFFORT under SCENE_MAX_TOKENS, a stop
# guard rather than a target, within SCENE_TIMEOUT_S; SCENE_MODEL draws it on the same endpoint
# and key, and empty means the reasoning model.
# SCENE_MODEL=
# SCENE_EFFORT=high
# SCENE_MAX_TOKENS=32000
# SCENE_TIMEOUT_S=600
# SIGNALING_PORT=8080
